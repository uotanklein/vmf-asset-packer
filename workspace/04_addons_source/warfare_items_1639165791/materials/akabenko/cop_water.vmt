"VertexlitGeneric"
{
	"$basetexture" "wick/cop/water/cop_water"
	"$bumpmap" "models/akabenko/item_token_normal"

	"%tooltexture" "wick/cop/water/cop_water"
	"%compilewater" 1
	"$abovewater" 1

	"$envmap" "env_cubemap"
	"$refracttexture" "_rt_WaterRefraction"
	"$refractamount" "1.0"
	//"$refracttint" "[0.95 1.0 0.97]"

	"$reflecttexture" "_rt_WaterReflection"
	"$reflectamount" "1.0"
	//"$reflecttint" "[1 1 1]"

	"$scale" "[1 1]"

	"$bumpmap" "wick/cop/water/cop_water_dudv"
	"$normalmap" "wick/cop/water/cop_water_normal"

	"$surfaceprop" "water"
	"$bottommaterial" "dev/dev_waterbeneath2"
	"$bumpframe" "0"

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30.00
		}

		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .05
			"texturescrollangle" 45.00
		}
	}
}
