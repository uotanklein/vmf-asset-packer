VertexLitGeneric
{
	$basetexture "wick/anarchycell/items/artefacts/cop/common/artifact_anim_lightning"

	$additive 1
	$nocull 1

	$selfillum 1
	$selfillumtint "[4 4 4]"

	Proxies
	{
		AnimatedTexture
		{
			animatedtexturevar "$basetexture"
			animatedtextureframenumvar "$frame"
			animatedtextureframerate 30.00
		}
	}
}