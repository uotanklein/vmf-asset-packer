VertexLitGeneric
{
	$basetexture "wick/anarchycell/items/artefacts/soc/fireball/fx_lavahell1"

	$alpha 0.5
	$additive 1

	$selfillum 1
	$selfillumtint "[3 3 3]"

	Proxies
	{
		AnimatedTexture
		{
			animatedtexturevar "$normalmap"
			animatedtextureframenumvar "$bumpframe"
			animatedtextureframerate 30.00
		}

		AnimatedTexture
		{
			animatedtexturevar "$basetexture"
			animatedtextureframenumvar "$frame"
			animatedtextureframerate 30.00
		}
	}
}