VertexLitGeneric
{
	$basetexture "wick/anarchycell/items/artefacts/cop/common/artifact_anim_dist"
	$bumpmap "wick/anarchycell/items/artefacts/cop/common/artifact_anim_dist"

	$additive 1

	$selfillum 1
	$selfillumtint "[0.50 0.50 0.50]"

	Proxies
	{
		AnimatedTexture
		{
			animatedtexturevar "$basetexture"
			animatedtextureframenumvar "$frame"
			animatedtextureframerate 20
		}
	}
}