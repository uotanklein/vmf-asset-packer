VertexLitGeneric
{
	$basetexture "models/loshara555/metroexodus/trainmetro_tex_0_g"
	$bumpmap "models/loshara555/metroexodus/trainmetro_tex_0_g_nm"
	$surfaceprop Wood

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.05 0.05 0.05]"

	$phong 1
	$phongfresnelranges "[0.2 0.5 0.2]"
	$phongexponent 20
	$phongboost 2

	$model 1
}