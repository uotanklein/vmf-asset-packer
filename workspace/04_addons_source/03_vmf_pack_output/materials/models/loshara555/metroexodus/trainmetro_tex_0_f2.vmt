VertexLitGeneric
{
	$basetexture "models/loshara555/metroexodus/trainmetro_tex_0_f2"
	$bumpmap "models/loshara555/metroexodus/trainmetro_tex_0_f2_nm"
	$surfaceprop Metal

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.10 0.10 0.10]"

	$phong 1
	$phongfresnelranges "[0.2 0.5 0.2]"
	$phongexponent 20
	$phongboost 2
	$phongalbedoboost 1.2

	$model 1
}