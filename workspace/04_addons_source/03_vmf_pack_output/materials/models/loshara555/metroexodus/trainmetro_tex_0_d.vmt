VertexLitGeneric
{
	$basetexture "models/loshara555/metroexodus/trainmetro_tex_0_d"
	$bumpmap "models/loshara555/metroexodus/trainmetro_tex_0_d_nm"
	$surfaceprop Wood

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.20 0.20 0.20]"

	$phong 1
	$phongfresnelranges "[0.2 0.5 0.2]"
	$phongexponent 20
	$phongboost 1.2

	$model 1
}