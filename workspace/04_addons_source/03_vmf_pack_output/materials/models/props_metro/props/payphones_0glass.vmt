"VertexLitGeneric"
{
    "$basetexture" "models/props_metro/props/payphones_0glass"
    "$model" 1
    "$nocull" "1"           // опционально, если нужна видимость с обеих сторон
    "$translucent" "1"      // делает материал прозрачным
    "$alpha" "1"            // множитель прозрачности, 1 = полностью видимый
}