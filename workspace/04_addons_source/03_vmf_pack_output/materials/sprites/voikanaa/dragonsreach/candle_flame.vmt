"Sprite"
{
	"$spriteorientation" "parallel_upright"
	"$spriteorigin" "[ 0.50 0.50 ]"
	"$basetexture" "sprites/voikanaa/dragonsreach/candle_flame"
	
	"Proxies"
	{
		"AnimatedTexture"
		{
		"animatedTextureVar" "$basetexture"
		"animatedTextureFrameNumVar" "$frame"
		"animatedTextureFrameRate" "12"
		}
	}
}
